# Alias git, được ~/.gitconfig nạp vào qua [include]. Xem docs/git.md.
# Tên ngắn giữ nguyên thói quen cũ; nhóm dưới là các lệnh hay phải gõ dài.
[alias]
    st = status
    co = checkout
    br = branch
    ba = branch -a
    bm = branch --merged
    bn = branch --no-merged
    ci = commit
    cm = commit
    df = diff
    cp = cherry-pick
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --decorate --date=short --color --decorate
    # Như lg nhưng mọi nhánh, để xem nhánh nào đang ở đâu so với master
    hist = log --graph --all --decorate --date=relative --pretty=format:'%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)'
    # Mở repo trên GitHub; nhận cả tham số của gh browse (vd. `git open -n` chỉ in URL)
    open = !gh browse
    # Ba lệnh cho lúc merge đang xung đột
    unmerged = !git ls-files --unmerged | cut -f2 | sort -u
    edit-unmerged = "!set -- $(git ls-files --unmerged | cut -f2 | sort -u); [ $# -gt 0 ] || { echo 'không có file nào đang xung đột'; exit 0; }; exec ${EDITOR:-nvim} \"$@\""
    add-unmerged = "!set -- $(git ls-files --unmerged | cut -f2 | sort -u); [ $# -gt 0 ] || { echo 'không có file nào đang xung đột'; exit 0; }; exec git add \"$@\""
