#!/bin/bash
# Quét những commit sắp được đẩy lên. Git đưa vào stdin: <local ref> <local sha> <remote ref> <remote sha>
# Bỏ qua có chủ đích: SKIP_GITLEAKS=1 git push ...
set -euo pipefail

[ "${SKIP_GITLEAKS:-}" = 1 ] && exit 0

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: chưa có gitleaks nên KHÔNG kiểm tra secret (brew install gitleaks)" >&2
  exit 0
fi

zero=0000000000000000000000000000000000000000
config="$(git rev-parse --show-toplevel)/.gitleaks.toml"
status=0

while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # xoá nhánh, không có gì để quét

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # nhánh mới: mọi commit chưa có trên remote nào
  else
    range="$remote_sha..$local_sha"
  fi

  args=(git --redact --no-banner "--log-opts=$range")
  [ -f "$config" ] && args+=(--config "$config")

  gitleaks "${args[@]}" || status=1
done

exit $status
